# Copy this file to ".env" and fill in real values. Never commit .env.

PORT=3000

# Local MongoDB, or a free MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/secure-chat

# Long random secret used to sign login tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: other websites allowed to use this server (comma separated),
# e.g. the chat-app front end hosted on GitHub Pages.
ALLOWED_ORIGINS=
